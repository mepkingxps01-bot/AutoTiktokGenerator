# =====================================================================
# Dr.Trader AI Carousel Factory: environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel → Settings → Environment Variables.
# NEVER commit real values. Only server code reads these (no NEXT_PUBLIC_ secrets).
# =====================================================================

# --- Dashboard authentication (required) -----------------------------
DASHBOARD_PASSWORD=change-me
# Random string >= 32 chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=
SESSION_HOURS=168

# --- Mock mode ---------------------------------------------------------
# true = no OpenAI calls, no cost, deterministic sample content (clearly labelled MOCK).
# Mock mode turns on automatically when OPENAI_API_KEY is empty.
MOCK_MODE=true

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5
OPENAI_IDEATION_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# minimal | low | medium | high | none (sent only to reasoning models)
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=150000
OPENAI_MAX_RETRIES=2
# Optional price overrides (USD per 1M tokens / per image), e.g.
# OPENAI_PRICING_JSON={"gpt-5":{"input":1.25,"output":10}}
OPENAI_PRICING_JSON=

# --- Supabase (leave empty to use the local file store in ./.data) -------
SUPABASE_URL=
# Service-role key: server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=carousel-assets

# --- Background worker ---------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Also used to chain worker calls.
CRON_SECRET=
# Optional separate secret for chained worker calls (defaults to CRON_SECRET)
WORKER_SECRET=
# Public URL of the deployment (optional; VERCEL_URL is used otherwise)
APP_URL=
# Only when Vercel Deployment Protection is on: lets the worker call itself
VERCEL_AUTOMATION_BYPASS_SECRET=
WORKER_BUDGET_MS=240000
WORKER_CONCURRENCY=3
STEP_MAX_ATTEMPTS=3

# --- Local dev store -----------------------------------------------------
# LOCAL_DATA_DIR=.data
